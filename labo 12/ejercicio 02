#include <iostream>
#include <string>
using namespace std;

int leerCantidad();
bool esPreguntaValida(string pregunta);
void registrarPreguntas(string preguntas[], int n);
void mostrarPreguntas(const string preguntas[], int n);

int main() {
    const int MAX = 100;
    string preguntas[MAX];
    int n;

    n = leerCantidad();
    registrarPreguntas(preguntas, n);
    mostrarPreguntas(preguntas, n);

    return 0;
}

int leerCantidad() {
    int n;
    do {
        cout << "Ingrese la cantidad de preguntas (1 - 100): ";
        cin >> n;
    } while (n < 1 || n > 100);
    cin.ignore();
    return n;
}

bool esPreguntaValida(string pregunta) {
    if (pregunta.length() == 0) {
        return false;
    }
    if (pregunta.at(0) == ' ' || pregunta.at(pregunta.length() - 1) == ' ') {
        return false;
    }
    return true;
}

void registrarPreguntas(string preguntas[], int n) {
    for (int i = 0; i < n; i++) {
        do {
            cout << "Pregunta " << i + 1 << ": ";
            getline(cin, preguntas[i]);
            if (!esPreguntaValida(preguntas[i])) {
                cout << "Error: La pregunta no debe estar vacia ni tener espacios al inicio o al final." << endl;
            }
        } while (!esPreguntaValida(preguntas[i]));
    }
}

void mostrarPreguntas(const string preguntas[], int n) {
    cout << "===== PREGUNTAS REGISTRADAS =====" << endl;
    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". " << preguntas[i] << endl;
    }
}
