#include <iostream>
#include <string>
using namespace std;

void mostrarMenu();
int contarCaracteres(string mensaje);
void buscarPalabra(string mensaje, string palabra);
string extraerTexto(string mensaje, int inicio, int cantidad);
void reemplazarPalabra(string &mensaje, string buscar, string nueva);

int main() {
    string mensaje, palabra, nueva;
    int opcion, inicio, cantidad;

    cout << "Ingrese el mensaje inicial: ";
    getline(cin, mensaje);

    do {
        mostrarMenu();
        cin >> opcion;
        cin.ignore();

        switch (opcion) {
            case 1:
                cout << "Cantidad de caracteres: " << contarCaracteres(mensaje) << endl;
                break;

            case 2:
                cout << "Ingrese la palabra a buscar: ";
                getline(cin, palabra);
                buscarPalabra(mensaje, palabra);
                break;

            case 3:
                if (mensaje.empty()) {
                    cout << "El mensaje esta vacio." << endl;
                    break;
                }
                do {
                    cout << "Posicion inicial (0 - " << mensaje.length() - 1 << "): ";
                    cin >> inicio;
                } while (inicio < 0 || inicio >= static_cast<int>(mensaje.length()));

                do {
                    cout << "Cantidad de caracteres: ";
                    cin >> cantidad;
                } while (cantidad <= 0);
                cin.ignore();

                cout << "Texto extraido: " << extraerTexto(mensaje, inicio, cantidad) << endl;
                break;

            case 4:
                cout << "Palabra a sustituir: ";
                getline(cin, palabra);
                cout << "Palabra nueva: ";
                getline(cin, nueva);
                reemplazarPalabra(mensaje, palabra, nueva);
                cout << "Mensaje actualizado: " << mensaje << endl;
                break;

            case 5:
                cout << "Mensaje actual: " << mensaje << endl;
                break;

            case 6:
                cout << "Saliendo del programa..." << endl;
                break;

            default:
                cout << "Opcion no valida." << endl;
        }
    } while (opcion != 6);

    return 0;
}

void mostrarMenu() {
    cout << "
--- ANALIZADOR DE MENSAJES ---" << endl;
    cout << "1. Contar caracteres" << endl;
    cout << "2. Buscar palabra" << endl;
    cout << "3. Extraer texto" << endl;
    cout << "4. Reemplazar palabra" << endl;
    cout << "5. Mostrar mensaje" << endl;
    cout << "6. Salir" << endl;
    cout << "Seleccione una opcion: ";
}

int contarCaracteres(string mensaje) {
    return mensaje.length();
}

void buscarPalabra(string mensaje, string palabra) {
    size_t pos = mensaje.find(palabra);
    if (pos != string::npos && pos < mensaje.length()) {
        cout << "Posicion: " << pos << endl;
    } else {
        cout << "Palabra no encontrada" << endl;
    }
}

string extraerTexto(string mensaje, int inicio, int cantidad) {
    return mensaje.substr(inicio, cantidad);
}

void reemplazarPalabra(string &mensaje, string buscar, string nueva) {
    size_t pos = mensaje.find(buscar);
    if (pos != string::npos && pos < mensaje.length()) {
        mensaje.replace(pos, buscar.length(), nueva);
    } else {
        cout << "Palabra no encontrada." << endl;
    }
}
