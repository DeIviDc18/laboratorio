#include <iostream>
#include <iomanip>
using namespace std;

void registrar(int notas[], int n);
void mostrar(const int notas[], int n);
float promedio(const int notas[], int n);
void mayorMenor(const int notas[], int n, int &mayor, int &menor);
int contarAprobados(const int notas[], int n);
int buscar(const int notas[], int n, int notaBuscar);
void actualizar(int notas[], int n);

int main() {
    const int MAX = 30;
    int notas[MAX];
    int n, mayor, menor, aprobados, reprobados, notaBuscar, pos;

    do {
        cout << "Cantidad de estudiantes (1 - 30): ";
        cin >> n;
    } while (n < 1 || n > 30);

    registrar(notas, n);
    mostrar(notas, n);

    cout << fixed << setprecision(2);
    cout << "Promedio: " << promedio(notas, n) << endl;

    mayorMenor(notas, n, mayor, menor);
    cout << "Mayor: " << mayor << "  |  Menor: " << menor << endl;

    aprobados = contarAprobados(notas, n);
    reprobados = n - aprobados;
    cout << "Aprobados: " << aprobados << "  |  Reprobados: " << reprobados << endl;

    cout << "Buscar nota: ";
    cin >> notaBuscar;
    pos = buscar(notas, n, notaBuscar);
    if (pos != -1) {
        cout << "Nota encontrada -> Estudiante " << pos + 1 << endl;
    } else {
        cout << "Nota no encontrada." << endl;
    }

    actualizar(notas, n);

    cout << "--- RESULTADOS ACTUALIZADOS ---" << endl;
    mostrar(notas, n);
    cout << "Nuevo promedio: " << promedio(notas, n) << endl;

    return 0;
}

void registrar(int notas[], int n) {
    for (int i = 0; i < n; i++) {
        do {
            cout << "Nota estudiante " << i + 1 << " (0 - 100): ";
            cin >> notas[i];
        } while (notas[i] < 0 || notas[i] > 100);
    }
}

void mostrar(const int notas[], int n) {
    cout << "Notas registradas:" << endl;
    for (int i = 0; i < n; i++) {
        cout << "Estudiante " << i + 1 << ": " << notas[i] << endl;
    }
}

float promedio(const int notas[], int n) {
    int suma = 0;
    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }
    return static_cast<float>(suma) / n;
}

void mayorMenor(const int notas[], int n, int &mayor, int &menor) {
    mayor = notas[0];
    menor = notas[0];
    for (int i = 1; i < n; i++) {
        if (notas[i] > mayor) {
            mayor = notas[i];
        }
        if (notas[i] < menor) {
            menor = notas[i];
        }
    }
}

int contarAprobados(const int notas[], int n) {
    int cont = 0;
    for (int i = 0; i < n; i++) {
        if (notas[i] >= 51) {
            cont++;
        }
    }
    return cont;
}

int buscar(const int notas[], int n, int notaBuscar) {
    for (int i = 0; i < n; i++) {
        if (notas[i] == notaBuscar) {
            return i;
        }
    }
    return -1;
}
void actualizar(int notas[], int n) {
    int est, nuevaNota;
    do {
        cout << "Modificar estudiante (1 - " << n << "): ";
        cin >> est;
    } while (est < 1 || est > n);

    do {
        cout << "Nueva nota (0 - 100): ";
        cin >> nuevaNota;
    } while (nuevaNota < 0 || nuevaNota > 100);

    notas[est - 1] = nuevaNota;
}
